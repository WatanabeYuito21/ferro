{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferro",
  "version": "0.0.19",
  "identifier": "com.ferro-mail.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ferro",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNDE2NUJBRTlEMDI0RDIKUldUU0pORHB1bVZCTENhajlpRmlTUERSV1JRTjJMTHZ1OXpMWnJGVW5Rb3dpWlhkc2tOOFc0ODcK",
      "endpoints": [
        "https://github.com/WatanabeYuito21/ferro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "../icons/ferro-32.png",
      "../icons/ferro-128.png",
      "../icons/ferro-256.png",
      "../icons/ferro-512.png"
    ],
    "windows": {
      "wix": {
        "language": ["en-US", "ja-JP"]
      },
      "nsis": {
        "languages": ["English", "Japanese"],
        "displayLanguageSelector": true
      }
    }
  }
}
